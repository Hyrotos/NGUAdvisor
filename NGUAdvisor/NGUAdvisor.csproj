<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style project targeting .NET Framework 4.8 (net48).
    net48 is REQUIRED: the DLL is injected into NGU Idle's Unity 2019.4 Mono (.NET 4.x) runtime,
    which cannot load a modern .NET assembly. See PLAN.md.

    Builds with just the .NET SDK (no Visual Studio, no admin targeting-pack install) because
    Microsoft.NETFramework.ReferenceAssemblies supplies the net48 reference assemblies via NuGet.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>NGUAdvisor</RootNamespace>
    <!--
      Hot reload requires a UNIQUE ASSEMBLY IDENTITY per build: Mono's Assembly.Load(byte[]) dedupes
      by simple name and silently returns the already-loaded assembly (verified: reload read the new
      file's bytes but started the old build). csc bakes the identity from the output file name, so
      the OUTPUT is NGUAdvisor.r<stamp>.dll; the deploy step renames the copy to NGUAdvisor.dll
      (identity lives in metadata — the on-disk name is irrelevant to both smi and byte-loading).
      Embedded resources are unaffected: fixed LogicalName + RootNamespace-based preset names.
    -->
    <AssemblyName>NGUAdvisor.r$([System.DateTime]::Now.ToString(yyMMddHHmmss))</AssemblyName>
    <!-- Properties/AssemblyInfo.cs provides the assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- the AssemblyVersion("x.y.*") wildcard in Properties/AssemblyInfo.cs requires non-deterministic builds -->
    <Deterministic>false</Deterministic>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <!-- Keep the stale committed copy of the game assembly and old release zip out of the build -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Assembly-CSharp.dll;dist_3.6.1.zip</DefaultItemExcludes>

    <!--
      WHICH BUILD IS THIS - the only line that differs between the dev repo and the public one.

      ⚠ IN THIS (PUBLIC) REPO THIS READS `public`; the dev tree reads `dev`. That is the whole port
      instruction: every .cs and the companion's index.html stay BYTE-IDENTICAL across the two trees,
      and this property is the single point of divergence. Nothing has to be stripped at port time,
      which is the point - a port law that relies on remembering to delete something is a port law
      that eventually does not happen.

      It drives the build footer. A dev build shows the advisor/companion build stamps and the drift
      warning, because those are the instrument that catches a stale deploy. A public build shows the
      product version and nothing else: a player has no companion to rebuild, and a "UI is stale"
      banner they cannot act on is just alarming.

      DEFAULT IS `dev` ON PURPOSE, and the direction matters. An unset or unreadable channel keeps the
      stamps, so the failure mode is a public build showing developer noise (cosmetic). The other
      default would silently remove the drift warning from the person who most needs it - the exact
      class of failure BuildStamp exists to prevent. THIS FILE MUST THEREFORE SET IT EXPLICITLY: with
      the property absent, a public release would ship the dev footer.

      NOT a DefineConstants / #if: this tree has zero conditional compilation and that is worth keeping.
      The value is baked in as assembly metadata, so it is also readable straight out of a shipped DLL
      when someone hands you a binary and asks which build it is.
    -->
    <AdvisorChannel Condition="'$(AdvisorChannel)' == ''">public</AdvisorChannel>
  </PropertyGroup>

  <!--
    Emits the channel as an assembly attribute. A generated file rather than a line in
    Properties/AssemblyInfo.cs because that file is hand-maintained, and b2abcf0 ("Reconcile the
    version carriers on 2.2.0: the two shipped binaries said 1.1 and 1.0") is what hand-maintained
    version carriers cost here. GenerateAssemblyInfo is false in both repos, so the SDK's own
    AssemblyMetadata item group is unavailable and this target does the job instead.
  -->
  <Target Name="GenerateAdvisorChannel" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <AdvisorChannelFile>$(IntermediateOutputPath)AdvisorChannel.g.cs</AdvisorChannelFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(AdvisorChannelFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated&gt; from &lt;AdvisorChannel&gt; in NGUAdvisor.csproj. Not committed - lives in obj/.;[assembly: System.Reflection.AssemblyMetadata(&quot;Channel&quot;, &quot;$(AdvisorChannel)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(AdvisorChannelFile)" />
    </ItemGroup>
  </Target>

  <!--
    Public-release hardening: strip debug metadata from the Release DLL. The SDK default
    (DebugType=portable) writes a PE CodeView record that embeds the local obj\Release PDB
    path into the shipped assembly. DebugType=None removes that debug directory and emits no
    PDB, so no local build path is embedded. Release only; Debug keeps its normal symbols.
    Method names stay in metadata (stack traces still name methods) and no PDB was ever
    shipped, so runtime line-number diagnostics are unchanged.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies from NuGet so no Visual Studio / targeting pack is needed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Goal loadout presets: embedded and auto-installed into the runtime profiles dir on first run
      (Managers/PresetInstaller). Plain JSON streams read fine under Mono (unlike WinForms resx).
      Resource names become NGUAdvisor.Presets.<file>.json.
    -->
    <None Remove="Presets\*.json" />
    <EmbeddedResource Include="Presets\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assemblies not referenced implicitly by the SDK -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <!--
    Where the game's Managed folder lives. Nothing machine-specific is committed here; the folder is
    resolved in this order, first hit wins:
      1. an explicit NguManagedDir (dotnet build -p:NguManagedDir=..., or NGUAdvisor.csproj.user,
         which MSBuild imports on its own and .gitignore already excludes)
      2. the NGU_MANAGED_DIR environment variable
      3. the usual Steam library locations on Linux and Windows, probed below
    Forward slashes throughout: MSBuild accepts them on Windows, and backslashes break on Linux.
  -->
  <PropertyGroup>
    <NguManagedDir Condition="'$(NguManagedDir)' == ''">$(NGU_MANAGED_DIR)</NguManagedDir>
    <_NguManagedRel>steamapps/common/NGU IDLE/NGUIdle_Data/Managed</_NguManagedRel>
    <_NguProbe>Assembly-CSharp.dll</_NguProbe>

    <!-- Linux: native Steam, the ~/.steam symlink layouts, then Flatpak Steam -->
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(HOME)' != '' And Exists('$(HOME)/.local/share/Steam/$(_NguManagedRel)/$(_NguProbe)')">$(HOME)/.local/share/Steam/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(HOME)' != '' And Exists('$(HOME)/.steam/steam/$(_NguManagedRel)/$(_NguProbe)')">$(HOME)/.steam/steam/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(HOME)' != '' And Exists('$(HOME)/.steam/root/$(_NguManagedRel)/$(_NguProbe)')">$(HOME)/.steam/root/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(HOME)' != '' And Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/$(_NguManagedRel)/$(_NguProbe)')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/$(_NguManagedRel)</NguManagedDir>

    <!-- Windows: the default Steam install, then a SteamLibrary folder on the common drive letters -->
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(OS)' == 'Windows_NT' And Exists('$(MSBuildProgramFiles32)/Steam/$(_NguManagedRel)/$(_NguProbe)')">$(MSBuildProgramFiles32)/Steam/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(OS)' == 'Windows_NT' And Exists('C:/SteamLibrary/$(_NguManagedRel)/$(_NguProbe)')">C:/SteamLibrary/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(OS)' == 'Windows_NT' And Exists('D:/SteamLibrary/$(_NguManagedRel)/$(_NguProbe)')">D:/SteamLibrary/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(OS)' == 'Windows_NT' And Exists('E:/SteamLibrary/$(_NguManagedRel)/$(_NguProbe)')">E:/SteamLibrary/$(_NguManagedRel)</NguManagedDir>
    <NguManagedDir Condition="'$(NguManagedDir)' == '' And '$(OS)' == 'Windows_NT' And Exists('F:/SteamLibrary/$(_NguManagedRel)/$(_NguProbe)')">F:/SteamLibrary/$(_NguManagedRel)</NguManagedDir>

    <NguManagedDir Condition="'$(NguManagedDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NguManagedDir)'))</NguManagedDir>
  </PropertyGroup>

  <!-- Fail with the fix spelled out, rather than with a wall of CS0246 for every game type. -->
  <Target Name="CheckNguManagedDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(NguManagedDir)' == '' Or !Exists('$(NguManagedDir)$(_NguProbe)')"
           Text="NGU Idle's Managed folder was not found (looked for $(_NguProbe) in '$(NguManagedDir)'). Point the build at &lt;steam library&gt;/$(_NguManagedRel): set the NGU_MANAGED_DIR environment variable, or pass -p:NguManagedDir=&lt;path&gt;. See BUILD.md." />
  </Target>

  <ItemGroup>
    <!--
      NGU Idle game assemblies (Unity 2019.4 / Mono), resolved from NguManagedDir above.
      Private=false: these are compile-time references only; never copy them to output.
    -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NguManagedDir)Assembly-CSharp.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(NguManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NguManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(NguManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(NguManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(NguManagedDir)UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NguManagedDir)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
